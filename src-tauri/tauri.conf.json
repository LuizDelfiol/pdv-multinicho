{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "pdv-multinicho",
  "version": "0.1.0",
  "identifier": "com.pdvmultinicho.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PDV",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyMUE0RTEyRjZBQkQ5REEKUldUYTJhdjJFazRhWWdFcllWb09PUG5ZQ2JzQmhQQjhFS2VORDk5MWcwWExRSTNBeFBDa2s4L1UK",
      "endpoints": ["https://github.com/LuizDelfiol/pdv-multinicho/releases/latest/download/latest.json"]
    }
  }
}
